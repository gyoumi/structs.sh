{
  "name": "structs.sh",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Workspace root: commit hooks, repo checks and the e2e suite",
  "packageManager": "pnpm@12.21.0",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "prepare": "husky",
    "instrumenter": "cargo build --release --target wasm32-unknown-unknown --manifest-path instrumenter/Cargo.toml && mkdir -p client/src/Services/debugger/wasm/generated && cp instrumenter/target/wasm32-unknown-unknown/release/structs_instrumenter.wasm client/src/Services/debugger/wasm/generated/instrumenter.wasm",
    "e2e": "playwright test -c e2e",
    "e2e:strict": "E2E_STRICT=1 playwright test -c e2e",
    "e2e:typecheck": "tsc -p e2e",
    "e2e:report": "playwright show-report e2e/playwright-report",
    "check:changed": "node scripts/check-changed.mjs",
    "check:pr": "node scripts/check-pr.mjs --local",
    "check:known-failures": "node scripts/check-known-failures.mjs",
    "check:file-sizes": "node scripts/check-file-sizes.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "e2e:lint": "eslint e2e",
    "knip": "knip --include files,unlisted,unresolved,binaries"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.4",
    "eslint-plugin-playwright": "^2.12.2",
    "husky": "^9.1.7",
    "knip": "^6.44.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "~8.59.0"
  }
}
