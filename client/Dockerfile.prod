# ===== Stage 0: Building the debugger's instrumenter =====
# The wasm debugger's Rust instrumenter (instrumenter/), built to .wasm.
FROM rust:1.99-slim AS instrumenter
WORKDIR /app
COPY rust-toolchain.toml ./
COPY instrumenter instrumenter
RUN rustup toolchain install \
 && cargo build --release --target wasm32-unknown-unknown --manifest-path instrumenter/Cargo.toml

# ===== Stage 1: Producing Build Files =====
# Build from the repo root, because the pnpm lockfile and workspace file live there.
FROM node:22-alpine AS build
COPY --from=ghcr.io/pnpm/pnpm:12.21.0-alpine /opt/pnpm /opt/pnpm
RUN ln -s /opt/pnpm/pnpm /usr/local/bin/pnpm

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY client/package.json client/

RUN pnpm install --frozen-lockfile --filter structs-client

COPY client client
COPY --from=instrumenter /app/instrumenter/target/wasm32-unknown-unknown/release/structs_instrumenter.wasm \
     client/src/Services/debugger/wasm/generated/instrumenter.wasm

# This outputs production-ready files to `client/build`
RUN pnpm --dir client run build

# Save gzipped copies of the larger files for nginx's gzip_static, so the
# compiler is compressed once here instead of on every request.
RUN find client/build/assets -type f -size +10k \
      \( -name '*.wasm' -o -name '*.tar' -o -name '*.js' -o -name '*.css' \) \
      -exec sh -c 'gzip -9 -c "$1" > "$1.gz"' _ {} \;

# ===== Stage 2: Setting up NGINX =====

FROM nginx:1.25.2-alpine

# From stage 1, copy the build files into the default directory that NGINX serves files from.
# The project will serve requests inbound at port 80 in the container
COPY --from=build /app/client/build /usr/share/nginx/html

EXPOSE 80

# We need to put in our own nginx config.
COPY client/nginx.conf /etc/nginx/nginx.conf
