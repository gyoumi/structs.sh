# Build from the repo root: docker compose sets the context, because the
# pnpm lockfile and workspace file live there.
FROM node:22-alpine
COPY --from=ghcr.io/pnpm/pnpm:12.21.0-alpine /opt/pnpm /opt/pnpm
RUN ln -s /opt/pnpm/pnpm /usr/local/bin/pnpm

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY client/package.json client/

RUN pnpm install --frozen-lockfile --filter structs-client

COPY client client

WORKDIR /app/client
CMD ["pnpm", "run", "start"]
